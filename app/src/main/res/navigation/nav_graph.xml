<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nearbyFragment">

    <fragment
        android:id="@+id/nearbyFragment"
        android:name="com.btnotifier.ui.nearby.NearbyFragment"
        android:label="Nearby"
        tools:layout="@layout/fragment_nearby"
        xmlns:tools="http://schemas.android.com/tools" />

    <fragment
        android:id="@+id/watchListFragment"
        android:name="com.btnotifier.ui.watchlist.WatchListFragment"
        android:label="Watch List"
        tools:layout="@layout/fragment_watch_list"
        xmlns:tools="http://schemas.android.com/tools" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.btnotifier.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings"
        xmlns:tools="http://schemas.android.com/tools" />

    <fragment
        android:id="@+id/healthFragment"
        android:name="com.btnotifier.ui.health.HealthFragment"
        android:label="Health" />

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.btnotifier.ui.history.HistoryFragment"
        android:label="History" />

    <fragment
        android:id="@+id/finderFragment"
        android:name="com.btnotifier.ui.finder.FinderFragment"
        android:label="Device finder">
        <argument android:name="address" app:argType="string" />
        <argument android:name="displayName" app:argType="string" />
    </fragment>
</navigation>
